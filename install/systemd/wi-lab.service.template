[Unit]
Description=Wi-Lab WiFi Access Point Manager
Documentation=https://github.com/caporalesimone/wi-lab
# time-sync.target: start after the clock is synchronized when the host waits
# for it; expiries use the monotonic clock anyway (STAB-5).
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
# Type=notify: Wi-Lab reports READY=1 after startup and pings the watchdog.
# It stops pinging only when a background loop has stalled and no reservation
# is active, so WatchdogSec restarts it without taking anyone's network (STAB-1).
Type=notify
NotifyAccess=main
WatchdogSec=90s
WorkingDirectory=WILAB_DIR
ExecStart=VENV_PATH/bin/python WILAB_DIR/main.py
Restart=always
RestartSec=10s
# Exit 78: a startup precheck failed (not root, missing command). Restarting
# does not fix it: leave the unit failed with the reason in the journal (NM-1).
RestartPreventExitStatus=78
TimeoutStartSec=60s
# Stop budget: 10 s for running requests, up to 10 s for discovery, up to 20 s
# to release every antenna in parallel (STAB-8).
TimeoutStopSec=60s
Environment="CONFIG_PATH=WILAB_DIR/config.yaml"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wilab

[Install]
WantedBy=multi-user.target
