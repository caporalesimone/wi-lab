# Every text file uses LF line endings, in the repository and in the working tree,
# whatever the platform or core.autocrlf setting.
* text=auto eol=lf

# Binary files: never convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.gz binary
*.zip binary
